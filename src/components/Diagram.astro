---
import { Image } from 'astro:assets';
import type { Diagram } from '../data/diagrams';

interface Props { diagram: Diagram }
const { src, alt } = Astro.props.diagram;
---
<figure class="diagram">
  <div class="scroll" tabindex="0" role="group" aria-label="Solution diagram, scrolls sideways on small screens">
    <a href={src.src} class="frame" aria-label="Open the full-size diagram">
      <Image src={src} alt={alt} widths={[640, 960, src.width]} sizes={`(min-width: 90rem) ${Math.min(src.width, 1280)}px, (max-width: 56rem) 720px, 100vw`} style={`max-width:${src.width}px`} />
    </a>
  </div>
  <figcaption>
    <span class="wide">Select the diagram to open it full size.</span>
    <span class="narrow">Scroll sideways to follow the diagram, or select it to open full size.</span>
  </figcaption>
</figure>

<style>
  .diagram { margin: 0; display: grid; gap: 0.75rem; min-width: 0; }
  .scroll { overflow-x: auto; overscroll-behavior-x: contain; }
  .frame { display: block; background: #fff; border: 1px solid var(--rule); border-top-color: var(--ink); padding: clamp(0.75rem, 2vw, 1.5rem); }
  .frame img { width: 100%; height: auto; margin-inline: auto; }
  .frame:hover { border-color: var(--edge); border-top-color: var(--ink); }
  figcaption { font-size: var(--t-small); color: var(--ink-3); }
  .narrow { display: none; }

  /* On phones the diagrams keep a readable width and scroll inside their frame. */
  @media (max-width: 56rem) {
    .frame { width: 45rem; }
    .wide { display: none; }
    .narrow { display: inline; }
  }
</style>
