---
import Arrow from './Arrow.astro';
const { current } = Astro.props;
const links = [
  { href: '/#build', label: 'What we build', id: 'build' },
  { href: '/case-studies', label: 'Case studies', id: 'case-studies' },
  // { href: '/#india', label: 'India teams', id: 'india' }, // hidden with the India section
  { href: '/stack', label: 'Stack', id: 'stack' },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="Palmtree Infotech, home">Palmtree<span aria-hidden="true">.</span></a>
    <nav aria-label="Main">
      <a class="btn mobile-cta" href="/#contact">Contact</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
        <span class="menu-label">Menu</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path class="l1" d="M3 7h14"/><path class="l2" d="M3 13h14"/></svg>
      </button>
      <ul id="site-menu">
        {links.map((l) => (
          <li><a href={l.href} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li class="cta"><a class="btn" href="/#contact">Start a conversation <Arrow /></a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const menu = document.getElementById('site-menu')!;
  const set = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
  };
  toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { set(false); toggle.focus(); }
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    border-bottom: 1px solid var(--rule);
  }
  @supports (backdrop-filter: blur(1px)) {
    .site-header { background: color-mix(in srgb, var(--paper) 82%, transparent); backdrop-filter: saturate(1.4) blur(10px); }
  }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; gap: 2rem; }
  .wordmark { font-weight: 700; font-size: 1.5rem; letter-spacing: -0.035em; text-decoration: none; }
  .wordmark span { color: var(--palm); }
  ul { display: flex; align-items: center; gap: clamp(1.25rem, 2.6vw, 2.5rem); list-style: none; padding: 0; }
  ul a:not(.btn) { text-decoration: none; font-size: 0.9688rem; font-weight: 500; padding-block: 0.5rem; }
  ul a:not(.btn):hover { color: var(--palm-deep); }
  ul a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--ink); }
  .cta .btn { padding: 0.8rem 1.1rem; min-height: 2.75rem; font-size: 0.9375rem; }
  .menu-toggle, .mobile-cta { display: none; }
  nav { display: flex; align-items: center; gap: 0.5rem; }

  @media (max-width: 56rem) {
    .mobile-cta { display: inline-flex; padding: 0 0.875rem; min-height: 2.75rem; font-size: 0.9375rem; }
    .menu-toggle {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font: 600 0.9375rem var(--sans); color: var(--ink);
      background: none; border: 1px solid var(--ink); padding: 0 0.875rem; min-height: 2.75rem; cursor: pointer;
    }
    .menu-toggle svg { width: 1.25rem; height: 1.25rem; stroke: currentColor; stroke-width: 1.6; fill: none; }
    .menu-toggle path { transition: transform 240ms var(--ease-out); transform-origin: center; }
    :global(.menu-open) .menu-toggle .l1 { transform: translateY(3px) rotate(45deg); }
    :global(.menu-open) .menu-toggle .l2 { transform: translateY(-3px) rotate(-45deg); }
    ul {
      position: fixed; inset: 4.5rem 0 auto 0; flex-direction: column; align-items: stretch; gap: 0;
      background: var(--paper); border-bottom: 1px solid var(--ink); padding: 0.5rem var(--gutter) 1.5rem;
      visibility: hidden; opacity: 0; transform: translateY(-0.5rem);
      transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out), visibility 0s 200ms;
    }
    :global(.menu-open) ul { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
    li { border-bottom: 1px solid var(--rule); }
    li.cta { border: 0; padding-top: 1.25rem; }
    ul a:not(.btn) { display: block; padding-block: 1rem; font-size: 1.125rem; }
    .cta .btn { width: 100%; justify-content: space-between; min-height: 3.25rem; font-size: 1rem; }
  }
</style>
